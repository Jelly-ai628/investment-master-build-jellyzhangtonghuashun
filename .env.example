# Copy to .env.local. Fill locally, never paste secrets into chat.
DEEPSEEK_API_KEY=
# Confirmed by the official documentation; account availability is checked before use.
DEEPSEEK_MODEL=deepseek-flash
FUYAO_API_KEY=
# Copy exact endpoint and authentication method from iFinD's generated MCP config.
IFIND_MCP_URL=
IFIND_MCP_TRANSPORT=streamable_http
IFIND_MCP_AUTH_HEADER=
# Full header value, including Bearer prefix only if the generated config requires it.
IFIND_MCP_AUTH_VALUE=
# iFinD news MCP endpoint (https://api-mcp.51ifind.com/...); used for event evidence. Treat as secret if it carries credentials.
IFIND_NEWS_URL=
# Web access: read from the process environment only (not from .env.local). Local default accepts 127.0.0.1 only.
# MARKET_PUBLIC=1 requires MARKET_ACCESS_CODE with at least 12 characters.
MARKET_PUBLIC=
MARKET_ACCESS_CODE=
